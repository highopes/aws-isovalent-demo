{
  "commands": [
    "set -euo pipefail",
    "UF_B64=''",
    "printf '%s' \"${UF_B64}\" | base64 -d > /tmp/uf-install.sh",
    "chmod +x /tmp/uf-install.sh",
    "export UF_VERSION='9.4.4'",
    "export UF_BUILD='f627d88b766b'",
    "export UF_ADMIN_PASS='cisco.123'",
    "export SPLUNK_INDEXER_HOST='172.31.38.104'",
    "export SPLUNK_INDEXER_PORT='9997'",
    "export UF_TETRAGON_LOG='/var/run/cilium/hubble/tetragon.log'",
    "export UF_ALERT_GLOB='/var/run/cilium/hubble/alert/*.log'",
    "export UF_SOURCETYPE_MAIN='_json'",
    "export UF_SOURCETYPE_ALERT='alert_json'",
    "export UF_ALERT_INDEX='alert'",
    "/tmp/uf-install.sh"
  ]
}
