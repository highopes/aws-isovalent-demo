set -a
# shellcheck disable=SC1090
source "${CONFIG_FILE}"
set +a

# 2) Decide workdir (allow override in kup.conf)
WORKDIR="${KUP_WORKDIR:-${SCRIPT_DIR}}"
mkdir -p "${WORKDIR}"
cd "${WORKDIR}"

need aws
need eksctl
need kubectl
need helm
need sed
need awk
need python3
need base64
need tr

