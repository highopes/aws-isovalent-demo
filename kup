#!/usr/bin/env bash
set -euo pipefail


export AWS_PAGER=""
export AWS_CLI_AUTO_PROMPT=off
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing command: $1"; }

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# 1) Find config first (allow override via env)
CONFIG_FILE="${KUP_CONFIG:-${SCRIPT_DIR}/kup.conf}"
[[ -f "${CONFIG_FILE}" ]] || die "config not found: ${CONFIG_FILE}"

set -a
# shellcheck disable=SC1090
source "${CONFIG_FILE}"
set +a

# 2) Decide workdir (allow override in kup.conf)
WORKDIR="${KUP_WORKDIR:-${SCRIPT_DIR}}"
mkdir -p "${WORKDIR}"
cd "${WORKDIR}"

need aws
need eksctl
need kubectl
need helm
need sed
need awk
need python3
need base64
need tr

: "${CLUSTER_NAME:?}"
: "${CLUSTER_ID:?}"
: "${REGION:?}"
: "${K8S_VERSION:?}"
: "${NG_NAME:?}"
: "${NG_INSTANCE_TYPE:?}"
: "${NG_DESIRED_CAPACITY:?}"
: "${NG_MIN_SIZE:?}"
: "${NG_MAX_SIZE:?}"
: "${NG_PRIVATE_NETWORKING:?}"
: "${CILIUM_CHART_VER:?}"
: "${PROM_RELEASE:?}"
: "${PROM_NAMESPACE:?}"
: "${OTEL_RELEASE:?}"
: "${OTEL_NAMESPACE:?}"
: "${NETCHECK_NAMESPACE:?}"
: "${NETCHECK_IMAGE:?}"
: "${TETRAGON_CHART_VER:?}"
: "${TPR_CHART_VER:?}"
: "${SPLUNK_INDEXER_HOST:?}"
: "${SPLUNK_INDEXER_PORT:?}"
: "${NODE_TIMEZONE:?}"
: "${ISO_REPO_URL:?}"

SPLUNK_VPC_ID="${SPLUNK_VPC_ID:-}"
EKS_VPC_ID="${EKS_VPC_ID:-}"
USE_EXISTING_VPC="false"
if [[ -n "${EKS_VPC_ID}" && -n "${SPLUNK_VPC_ID}" && "${EKS_VPC_ID}" == "${SPLUNK_VPC_ID}" ]]; then
  USE_EXISTING_VPC="true"
fi

UF_ENABLE="${UF_ENABLE:-false}"
SPLUNK_SG_AUTOCONFIG="${SPLUNK_SG_AUTOCONFIG:-false}"
SSM_REGISTER_TIMEOUT_SEC="${SSM_REGISTER_TIMEOUT_SEC:-900}"
SSM_COMMAND_TIMEOUT_SEC="${SSM_COMMAND_TIMEOUT_SEC:-3600}"
SSM_MAX_CONCURRENCY="${SSM_MAX_CONCURRENCY:-50}"
SSM_MAX_ERRORS="${SSM_MAX_ERRORS:-0}"

TETRAGON_EXPORT_DIR="${TETRAGON_EXPORT_DIR:-/var/run/cilium/hubble}"
TETRAGON_EXPORT_FILENAME="${TETRAGON_EXPORT_FILENAME:-tetragon.log}"
TETRAGON_ALERT_DIR="${TETRAGON_ALERT_DIR:-/var/run/cilium/hubble/alert}"
TETRAGON_EXPORT_ALLOWLIST="${TETRAGON_EXPORT_ALLOWLIST:-}"
TETRAGON_EXPORT_DENYLIST="${TETRAGON_EXPORT_DENYLIST:-}"

KUBECONFIG_FILE="${KUBECONFIG:-${HOME}/.kube/config}"
CTX_ALIAS="${CLUSTER_NAME}-${CLUSTER_ID}"

TPL_CLUSTER="${WORKDIR}/cluster.yaml"
TPL_NODEGROUP="${WORKDIR}/nodegroup.yaml"
TPL_CILIUM="${WORKDIR}/cilium-enterprise-values.yaml"
TPL_NETCHECK="${WORKDIR}/netcheck.yaml"
TPL_CNP_ALLOW="${WORKDIR}/otel-demo-allow-all.yaml"
TPL_CNP_L7="${WORKDIR}/otel-demo-l7-visibility.yaml"
TPL_TETRAGON="${WORKDIR}/tetragon.yaml"
TPL_TPR="${WORKDIR}/tpr-values.yaml"

for f in "${TPL_CLUSTER}" "${TPL_NODEGROUP}" "${TPL_CILIUM}" "${TPL_NETCHECK}" "${TPL_CNP_ALLOW}" "${TPL_CNP_L7}" "${TPL_TETRAGON}" "${TPL_TPR}"; do
  [[ -f "${f}" ]] || die "template not found: ${f}"
done

render_template() {
  local in="$1"
  local out="$2"
  python3 - "$in" "$out" <<'PY'
import os, sys
from string import Template

inp, outp = sys.argv[1], sys.argv[2]
with open(inp, "r", encoding="utf-8") as f:
    s = f.read()
t = Template(s)
rendered = t.safe_substitute(os.environ)
with open(outp, "w", encoding="utf-8") as f:
    f.write(rendered)
PY
}

render_show() {
  local in="$1"
  local out="$2"
  log "render ${in} -> ${out}"
  render_template "${in}" "${out}"
  printf '\n----- BEGIN %s -----\n' "$(basename "${out}")"
  cat "${out}"
  printf '\n----- END %s -----\n\n' "$(basename "${out}")"
}

inject_existing_vpc_cluster_config() {
  local cluster_yaml="$1"
  [[ "${USE_EXISTING_VPC}" == "true" ]] || return 0

  [[ -n "${EKS_VPC_ID}" ]] || die "EKS_VPC_ID is empty"
  log "use existing vpc for eks cluster: ${EKS_VPC_ID}"

  local data_json="${WORKDIR}/vpc-subnets-${CLUSTER_ID}.json"
  aws ec2 describe-subnets \
    --region "${REGION}" \
    --filters "Name=vpc-id,Values=${EKS_VPC_ID}" \
    --output json > "${data_json}"

  local rtb_json="${WORKDIR}/vpc-rtbs-${CLUSTER_ID}.json"
  aws ec2 describe-route-tables \
    --region "${REGION}" \
    --filters "Name=vpc-id,Values=${EKS_VPC_ID}" \
    --output json > "${rtb_json}"

  local vpc_block="${WORKDIR}/vpc-${CLUSTER_ID}.yaml"
  local subnet_ids="${WORKDIR}/vpc-subnet-ids-${CLUSTER_ID}.txt"

  python3 - "${data_json}" "${rtb_json}" "${vpc_block}" "${subnet_ids}" <<'PY'
import json, sys
from collections import defaultdict

subnets_json, rtbs_json, out_block, out_ids = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
subs = json.load(open(subnets_json, "r", encoding="utf-8")).get("Subnets", []) or []
rtbs = json.load(open(rtbs_json, "r", encoding="utf-8")).get("RouteTables", []) or []

main_rtb_id = None
rtb_by_id = {}
for rtb in rtbs:
    rid = rtb.get("RouteTableId")
    if rid:
        rtb_by_id[rid] = rtb
    for assoc in (rtb.get("Associations") or []):
        if assoc.get("Main"):
            main_rtb_id = rid

subnet_rtb = {}
for rtb in rtbs:
    rid = rtb.get("RouteTableId")
    for assoc in (rtb.get("Associations") or []):
        sid = assoc.get("SubnetId")
        if sid and rid:
            subnet_rtb[sid] = rid

def is_public_rtb(rtb):
    for r in (rtb.get("Routes") or []):
        if r.get("DestinationCidrBlock") == "0.0.0.0/0":
            gw = r.get("GatewayId") or ""
            if gw.startswith("igw-"):
                return True
    return False

pub = defaultdict(list)
priv = defaultdict(list)

for s in subs:
    sid = s.get("SubnetId")
    az = s.get("AvailabilityZone")
    if not sid or not az:
        continue

    rid = subnet_rtb.get(sid) or main_rtb_id
    rtb = rtb_by_id.get(rid) if rid else None
    if rtb and is_public_rtb(rtb):
        pub[az].append(sid)
    else:
        priv[az].append(sid)

priv_sel = {az: ids[0] for az, ids in sorted(priv.items()) if ids}
pub_sel = {az: ids[0] for az, ids in sorted(pub.items()) if ids}

lines = []
lines.append("vpc:")
lines.append("  id: __EKS_VPC_ID__")
lines.append("  subnets:")
lines.append("    private:")
for az, sid in priv_sel.items():
    lines.append(f"      {az}:")
    lines.append(f"        id: {sid}")
lines.append("    public:")
for az, sid in pub_sel.items():
    lines.append(f"      {az}:")
    lines.append(f"        id: {sid}")

with open(out_block, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")

with open(out_ids, "w", encoding="utf-8") as f:
    for az, sid in priv_sel.items():
        f.write(f"private {az} {sid}\n")
    for az, sid in pub_sel.items():
        f.write(f"public {az} {sid}\n")
PY

  sed -i.bak "s/__EKS_VPC_ID__/${EKS_VPC_ID}/g" "${vpc_block}" || true
  rm -f "${vpc_block}.bak" >/dev/null 2>&1 || true

  local priv_count pub_count total_count
  priv_count="$(awk '$1=="private"{c++} END{print c+0}' "${subnet_ids}")"
  pub_count="$(awk '$1=="public"{c++} END{print c+0}' "${subnet_ids}")"
  total_count=$((priv_count + pub_count))

  if (( total_count < 2 )); then
    die "not enough subnets in vpc ${EKS_VPC_ID} (need >=2 across AZ)"
  fi

  if [[ "${NG_PRIVATE_NETWORKING}" == "true" && "${priv_count}" -lt 2 ]]; then
    die "NG_PRIVATE_NETWORKING=true but found only ${priv_count} private subnets in vpc ${EKS_VPC_ID}"
  fi

  log "tag selected subnets for eks"
  while read -r kind az sid; do
    [[ -n "${sid}" ]] || continue
    aws ec2 create-tags \
      --region "${REGION}" \
      --resources "${sid}" \
      --tags "Key=kubernetes.io/cluster/${CLUSTER_NAME},Value=shared" \
      >/dev/null 2>&1 || true

    if [[ "${kind}" == "public" ]]; then
      aws ec2 create-tags \
        --region "${REGION}" \
        --resources "${sid}" \
        --tags "Key=kubernetes.io/role/elb,Value=1" \
        >/dev/null 2>&1 || true
    else
      aws ec2 create-tags \
        --region "${REGION}" \
        --resources "${sid}" \
        --tags "Key=kubernetes.io/role/internal-elb,Value=1" \
        >/dev/null 2>&1 || true
    fi
  done < "${subnet_ids}"

  log "inject vpc config block into ${cluster_yaml}"
  printf '\n# injected by kup: use existing vpc %s\n' "${EKS_VPC_ID}" >> "${cluster_yaml}"
  cat "${vpc_block}" >> "${cluster_yaml}"
}

wait_for_ds_ready() {
  local ns="$1"
  local name="$2"
  local timeout_sec="$3"
  local start now desired ready
  start="$(date +%s)"
  while true; do
    now="$(date +%s)"
    if (( now - start > timeout_sec )); then
      kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o wide || true
      die "timeout waiting for daemonset ready"
    fi
    desired="$(kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
    ready="$(kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
    if [[ -n "${desired}" && -n "${ready}" && "${desired}" == "${ready}" && "${desired}" != "0" ]]; then
      break
    fi
    sleep 5
  done
}

get_node_instance_ids() {
  kubectl --context "${CTX_ALIAS}" get nodes -o jsonpath='{range .items[*]}{.spec.providerID}{"\n"}{end}' \
    | awk -F/ 'NF>0{print $NF}' \
    | awk 'NF>0{print}'
}

cluster_exists() {
  aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${REGION}" \
    --query "cluster.name" \
    --output text >/dev/null 2>&1
}

nodegroup_exists() {
  aws eks describe-nodegroup \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NG_NAME}" \
    --region "${REGION}" \
    --query "nodegroup.nodegroupName" \
    --output text >/dev/null 2>&1
}

ssm_is_managed() {
  local iid="$1"
  local got
  got="$(aws ssm describe-instance-information \
    --filters "Key=InstanceIds,Values=${iid}" \
    --query "InstanceInformationList[0].InstanceId" \
    --output text 2>/dev/null || true)"
  [[ "${got}" == "${iid}" ]]
}

wait_for_ssm_all() {
  local timeout_sec="$1"
  shift
  local ids=("$@")
  local deadline=$(( $(date +%s) + timeout_sec ))
  while :; do
    local ok=0
    local iid
    for iid in "${ids[@]}"; do
      if ssm_is_managed "${iid}"; then ok=$((ok+1)); fi
    done
    if [[ "${ok}" -eq "${#ids[@]}" ]]; then return 0; fi
    if [[ "$(date +%s)" -ge "${deadline}" ]]; then return 1; fi
    sleep 10
  done
}

wait_for_ssm_one() {
  local iid="$1"
  local timeout_sec="$2"
  local deadline=$(( $(date +%s) + timeout_sec ))
  while :; do
    if ssm_is_managed "${iid}"; then return 0; fi
    if [[ "$(date +%s)" -ge "${deadline}" ]]; then return 1; fi
    sleep 10
  done
}

ensure_node_role_ssm_policy_if_needed() {
  IDS=()
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "None" ]] || continue
    IDS+=("$line")
  done < <(get_node_instance_ids || true)
  [[ "${#IDS[@]}" -gt 0 ]] || die "no node instance ids found"

  if wait_for_ssm_all 60 "${IDS[@]}"; then
    log "ssm managed: ok"
    return 0
  fi

  log "ssm not ready for all nodes; try attach AmazonSSMManagedInstanceCore to node role"

  local role_arn role_name
  role_arn="$(aws eks describe-nodegroup \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NG_NAME}" \
    --region "${REGION}" \
    --query "nodegroup.nodeRole" \
    --output text)"

  [[ -n "${role_arn}" && "${role_arn}" != "None" ]] || die "failed to get node role arn"
  role_name="${role_arn##*/}"

  aws iam attach-role-policy \
    --role-name "${role_name}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore" \
    >/dev/null 2>&1 || true

  if ! wait_for_ssm_all "${SSM_REGISTER_TIMEOUT_SEC}" "${IDS[@]}"; then
    die "ssm still not ready for all nodes"
  fi

  log "ssm managed: ok after attach"
}

run_ssm_shell_all_nodes() {
  local params_json="$1"
  IDS=()
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "None" ]] || continue
    IDS+=("$line")
  done < <(get_node_instance_ids)
  local cmd_id
  cmd_id="$(aws ssm send-command \
    --document-name "AWS-RunShellScript" \
    --instance-ids "${IDS[@]}" \
    --parameters "file://${params_json}" \
    --timeout-seconds "${SSM_COMMAND_TIMEOUT_SEC}" \
    --max-concurrency "${SSM_MAX_CONCURRENCY}" \
    --max-errors "${SSM_MAX_ERRORS}" \
    --query "Command.CommandId" \
    --output text)"
  log "ssm command id: ${cmd_id}"
  aws --no-cli-pager ssm list-command-invocations \
    --command-id "${cmd_id}" \
    --query "CommandInvocations[*].[InstanceId,Status,StatusDetails]" \
    --output table || true
}

ensure_splunk_sg_ingress() {
  [[ "${SPLUNK_SG_AUTOCONFIG}" == "true" ]] || { log "skip splunk sg autoconfig"; return 0; }
  : "${SPLUNK_EC2_SG_ID:?}"

  local cluster_sg cluster_vpc splunk_vpc
  cluster_sg="$(aws eks describe-cluster \
    --name "${CLUSTER_NAME}" --region "${REGION}" \
    --query "cluster.resourcesVpcConfig.clusterSecurityGroupId" --output text)"
  cluster_vpc="$(aws eks describe-cluster \
    --name "${CLUSTER_NAME}" --region "${REGION}" \
    --query "cluster.resourcesVpcConfig.vpcId" --output text)"
  splunk_vpc="$(aws ec2 describe-security-groups \
    --group-ids "${SPLUNK_EC2_SG_ID}" \
    --query "SecurityGroups[0].VpcId" --output text)"

  [[ "${splunk_vpc}" == "${cluster_vpc}" ]] || die "vpc mismatch for splunk sg and eks cluster"

  aws ec2 authorize-security-group-ingress \
    --group-id "${SPLUNK_EC2_SG_ID}" \
    --ip-permissions "IpProtocol=tcp,FromPort=${SPLUNK_INDEXER_PORT},ToPort=${SPLUNK_INDEXER_PORT},UserIdGroupPairs=[{GroupId=${cluster_sg}}]" \
    >/dev/null 2>&1 || true

  log "splunk sg ingress ensured"
}

set_nodes_timezone() {
  local params="ssm-timezone-${CLUSTER_ID}.json"
  cat > "${params}" <<EOF
{
  "commands": [
    "set -euo pipefail",
    "sudo timedatectl set-timezone '${NODE_TIMEZONE}' || true",
    "timedatectl status | sed -n '1,12p' || true"
  ]
}
EOF
  run_ssm_shell_all_nodes "${params}"
}

install_uf_all_nodes() {
  [[ "${UF_ENABLE}" == "true" ]] || { log "skip uf install"; return 0; }

  : "${UF_VERSION:?}"
  : "${UF_BUILD:?}"
  : "${UF_ADMIN_PASS:?}"
  : "${UF_TETRAGON_LOG:?}"
  : "${UF_ALERT_GLOB:?}"
  : "${UF_SOURCETYPE_MAIN:?}"
  : "${UF_SOURCETYPE_ALERT:?}"
  : "${UF_ALERT_INDEX:?}"

  local uf_script="${WORKDIR}/uf-install-${CLUSTER_ID}.sh"
  cat > "${uf_script}" <<'EOF'
#!/usr/bin/env bash
set -euo pipefail

SPLUNK_HOME="/opt/splunkforwarder"

UF_VERSION="${UF_VERSION}"
UF_BUILD="${UF_BUILD}"
UF_PASS="${UF_ADMIN_PASS}"

INDEXER_HOST="${SPLUNK_INDEXER_HOST}"
INDEXER_PORT="${SPLUNK_INDEXER_PORT}"

TETRAGON_LOG="${UF_TETRAGON_LOG}"
ALERT_GLOB="${UF_ALERT_GLOB}"

ST_MAIN="${UF_SOURCETYPE_MAIN}"
ST_ALERT="${UF_SOURCETYPE_ALERT}"
ALERT_INDEX="${UF_ALERT_INDEX}"

log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >&2; }
need() { command -v "$1" >/dev/null 2>&1; }

arch() {
  case "$(uname -m)" in
    x86_64|amd64) echo "x86_64" ;;
    aarch64|arm64) echo "aarch64" ;;
    *) echo "unsupported" ;;
  esac
}

pm() {
  if need dnf; then echo "dnf"
  elif need yum; then echo "yum"
  elif need apt-get; then echo "apt"
  else echo "none"
  fi
}

ensure_curl() {
  if need curl; then return 0; fi
  case "$(pm)" in
    dnf) dnf install -y curl-minimal ;;
    yum) yum install -y curl ;;
    apt) apt-get update -y && apt-get install -y curl ;;
    *) echo "no curl and no package manager" >&2; exit 1 ;;
  esac
}

download_rpm() {
  local a="$1"
  local base="https://download.splunk.com/products/universalforwarder/releases/${UF_VERSION}/linux"
  local file
  if [[ "$a" == "x86_64" ]]; then
    file="splunkforwarder-${UF_VERSION}-${UF_BUILD}.x86_64.rpm"
  else
    file="splunkforwarder-${UF_VERSION}-${UF_BUILD}.aarch64.rpm"
  fi
  echo "${base}/${file} ${file}"
}

install_pkg() {
  local a="$1"
  local p
  p="$(pm)"
  if [[ "$p" == "apt" ]]; then
    echo "rpm-based install expected on EKS nodes" >&2
    exit 1
  fi

  ensure_curl

  local url file tmpdir
  read -r url file < <(download_rpm "$a")
  tmpdir="/tmp/splunk-uf"
  mkdir -p "$tmpdir"

  log "download ${url}"
  curl -fL --retry 5 --retry-delay 2 --connect-timeout 15 --max-time 900 -o "${tmpdir}/${file}" "$url"

  if [[ -x "${SPLUNK_HOME}/bin/splunk" ]]; then
    "${SPLUNK_HOME}/bin/splunk" stop || true
  fi

  if [[ "$p" == "dnf" ]]; then
    dnf install -y "${tmpdir}/${file}"
  else
    yum install -y "${tmpdir}/${file}"
  fi
}

seed_start_stop() {
  "${SPLUNK_HOME}/bin/splunk" start --accept-license --answer-yes --no-prompt --seed-passwd "${UF_PASS}" || true
  "${SPLUNK_HOME}/bin/splunk" stop || true
}

write_confs() {
  mkdir -p "${SPLUNK_HOME}/etc/system/local"

  cat > "${SPLUNK_HOME}/etc/system/local/outputs.conf" <<EOC
[tcpout]
defaultGroup = default-indexer

[tcpout:default-indexer]
server = ${INDEXER_HOST}:${INDEXER_PORT}

[tcpout-server://${INDEXER_HOST}:${INDEXER_PORT}]
EOC

  cat > "${SPLUNK_HOME}/etc/system/local/inputs.conf" <<EOC
[monitor://${TETRAGON_LOG}]
sourcetype = ${ST_MAIN}

[monitor://${ALERT_GLOB}]
sourcetype = ${ST_ALERT}
index = ${ALERT_INDEX}
EOC

  cat > "${SPLUNK_HOME}/etc/system/local/props.conf" <<EOC
[_json]
TRUNCATE = 0

[${ST_ALERT}]
INDEXED_EXTRACTIONS = json
KV_MODE = none
SHOULD_LINEMERGE = false
category = Structured
TRUNCATE = 0
EOC

  cat > "${SPLUNK_HOME}/etc/system/local/limits.conf" <<'EOC'
[thruput]
maxKBps = 0
EOC
}

enable_boot_start() {
  "${SPLUNK_HOME}/bin/splunk" enable boot-start -user root || true
}

start_uf() {
  "${SPLUNK_HOME}/bin/splunk" start || true
  "${SPLUNK_HOME}/bin/splunk" status || true
}

main() {
  local a
  a="$(arch)"
  [[ "$a" != "unsupported" ]] || { echo "unsupported arch" >&2; exit 1; }

  install_pkg "$a"
  [[ -x "${SPLUNK_HOME}/bin/splunk" ]] || { echo "splunk binary not found" >&2; exit 1; }

  seed_start_stop
  write_confs
  enable_boot_start
  start_uf
}

main "$@"
EOF
  chmod +x "${uf_script}"

  local uf_b64 params
  uf_b64="$(base64 < "${uf_script}" | tr -d '\n')"
  params="ssm-uf-${CLUSTER_ID}.json"
  cat > "${params}" <<EOF
{
  "commands": [
    "set -euo pipefail",
    "UF_B64='${uf_b64}'",
    "printf '%s' \"\${UF_B64}\" | base64 -d > /tmp/uf-install.sh",
    "chmod +x /tmp/uf-install.sh",
    "export UF_VERSION='${UF_VERSION}'",
    "export UF_BUILD='${UF_BUILD}'",
    "export UF_ADMIN_PASS='${UF_ADMIN_PASS}'",
    "export SPLUNK_INDEXER_HOST='${SPLUNK_INDEXER_HOST}'",
    "export SPLUNK_INDEXER_PORT='${SPLUNK_INDEXER_PORT}'",
    "export UF_TETRAGON_LOG='${UF_TETRAGON_LOG}'",
    "export UF_ALERT_GLOB='${UF_ALERT_GLOB}'",
    "export UF_SOURCETYPE_MAIN='${UF_SOURCETYPE_MAIN}'",
    "export UF_SOURCETYPE_ALERT='${UF_SOURCETYPE_ALERT}'",
    "export UF_ALERT_INDEX='${UF_ALERT_INDEX}'",
    "/tmp/uf-install.sh"
  ]
}
EOF
  run_ssm_shell_all_nodes "${params}"
}

log "workdir=${WORKDIR} cluster=${CLUSTER_NAME} id=${CLUSTER_ID} region=${REGION} context=${CTX_ALIAS}"

CLUSTER_OUT="${WORKDIR}/cluster-${CLUSTER_ID}.yaml"
NODEGROUP_OUT="${WORKDIR}/nodegroup-${CLUSTER_ID}.yaml"

log "render ${TPL_CLUSTER} -> ${CLUSTER_OUT}"
render_template "${TPL_CLUSTER}" "${CLUSTER_OUT}"
inject_existing_vpc_cluster_config "${CLUSTER_OUT}"
printf '\n----- BEGIN %s -----\n' "$(basename "${CLUSTER_OUT}")"
cat "${CLUSTER_OUT}"
printf '\n----- END %s -----\n\n' "$(basename "${CLUSTER_OUT}")"
render_show "${TPL_NODEGROUP}" "${NODEGROUP_OUT}"

log "create cluster control plane"
if cluster_exists; then
  log "cluster exists; skip create cluster"
else
  eksctl create cluster -f "${CLUSTER_OUT}"
fi

