select_egress_gateway_nodes() {
  local nodes_json="${WORKDIR}/egress-gw-nodes-${CLUSTER_ID}.json"
  local desired_count="2"
  if [[ "${EGRESS_GW_HA_ENABLE}" != "true" ]]; then
    desired_count="1"
  fi

  kubectl --context "${CTX_ALIAS}" get nodes -o json > "${nodes_json}"
  python3 - "${nodes_json}" "${EGRESS_GW_NODE_NAMES}" "${desired_count}" <<'PY'
import json, sys

nodes_json, requested_csv, desired_count_s = sys.argv[1], sys.argv[2].strip(), sys.argv[3]
desired_count = int(desired_count_s)
data = json.load(open(nodes_json, "r", encoding="utf-8"))

ready_nodes = []
for node in data.get("items", []):
    name = node.get("metadata", {}).get("name", "")
    labels = node.get("metadata", {}).get("labels", {}) or {}
    zone = labels.get("topology.kubernetes.io/zone", "")
    conditions = node.get("status", {}).get("conditions", []) or []
    ready = any(c.get("type") == "Ready" and c.get("status") == "True" for c in conditions)
    schedulable = not node.get("spec", {}).get("unschedulable", False)
    if name and ready and schedulable:
        ready_nodes.append({"name": name, "zone": zone})

by_name = {n["name"]: n for n in ready_nodes}
if len(ready_nodes) <= desired_count:
    print(f"need at least {desired_count + 1} Ready schedulable nodes so non-gateway workloads have a place to run", file=sys.stderr)
    raise SystemExit(1)

requested = [x.strip() for x in requested_csv.split(",") if x.strip()]
if requested:
    if len(requested) != desired_count:
        print(f"EGRESS_GW_NODE_NAMES must contain exactly {desired_count} node name(s)", file=sys.stderr)
        raise SystemExit(1)
    missing = [name for name in requested if name not in by_name]
    if missing:
        print(f"requested egress gateway node(s) are not Ready/schedulable: {', '.join(missing)}", file=sys.stderr)
        raise SystemExit(1)
    selected = [by_name[name] for name in requested]
else:
    selected = []
    used_zones = set()
    for node in sorted(ready_nodes, key=lambda n: (n["zone"], n["name"])):
        if desired_count > 1 and node["zone"] in used_zones:
            continue
        selected.append(node)
        used_zones.add(node["zone"])
        if len(selected) == desired_count:
            break

if len(selected) != desired_count:
    print(f"failed to select {desired_count} egress gateway node(s) across distinct zones", file=sys.stderr)
    raise SystemExit(1)

if desired_count > 1 and len({n["zone"] for n in selected}) != len(selected):
    print("selected HA egress gateway nodes must be in distinct zones", file=sys.stderr)
    raise SystemExit(1)

for node in selected:
    print(node["name"])
PY
}

apply_egress_gateway_node_labels() {
  local gw_nodes=()
  local gw_ips=()
  local node
  while IFS= read -r node; do
    [[ -n "${node}" ]] || continue
    gw_nodes+=("${node}")
  done < <(select_egress_gateway_nodes)

  [[ "${#gw_nodes[@]}" -gt 0 ]] || die "no egress gateway nodes selected"

  log "clear previous egress gateway labels"
  kubectl --context "${CTX_ALIAS}" label nodes --all \
    "${EGRESS_GW_NODE_LABEL_KEY}-" \
    "io.cilium/egress-gateway-" \
    --overwrite >/dev/null 2>&1 || true

  log "label egress gateway nodes: ${gw_nodes[*]}"
  for node in "${gw_nodes[@]}"; do
    kubectl --context "${CTX_ALIAS}" label node "${node}" \
      "${EGRESS_GW_NODE_LABEL_KEY}=${EGRESS_GW_NODE_LABEL_VALUE}" \
      "io.cilium/egress-gateway=true" \
      --overwrite
    local ip
    ip="$(kubectl --context "${CTX_ALIAS}" get node "${node}" -o jsonpath='{.status.addresses[?(@.type=="InternalIP")].address}')"
    [[ -n "${ip}" ]] || die "failed to get InternalIP for egress gateway node ${node}"
    gw_ips+=("${ip}")
  done

  EGRESS_GW_SELECTED_NODE_NAMES="$(IFS=,; echo "${gw_nodes[*]}")"
  EGRESS_GW_SELECTED_NODE_IPS="$(IFS=,; echo "${gw_ips[*]}")"
  export EGRESS_GW_SELECTED_NODE_NAMES EGRESS_GW_SELECTED_NODE_IPS
}

find_remote_outpost_instance_id() {
  if [[ -n "${EGRESS_GW_REMOTE_OUTPOST_INSTANCE_ID}" ]]; then
    printf '%s\n' "${EGRESS_GW_REMOTE_OUTPOST_INSTANCE_ID}"
    return 0
  fi

  local cluster_vpc ids
  cluster_vpc="$(aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${REGION}" \
    --query "cluster.resourcesVpcConfig.vpcId" \
    --output text)"
  [[ -n "${cluster_vpc}" && "${cluster_vpc}" != "None" ]] || die "failed to get EKS VPC ID"

  mapfile -t ids < <(aws ec2 describe-instances \
    --region "${REGION}" \
    --filters \
      "Name=tag:Name,Values=${EGRESS_GW_REMOTE_OUTPOST_INSTANCE_NAME}" \
      "Name=vpc-id,Values=${cluster_vpc}" \
      "Name=instance-state-name,Values=running" \
    --query "Reservations[].Instances[].InstanceId" \
    --output text | tr '\t' '\n' | awk 'NF>0')

  if [[ "${#ids[@]}" -ne 1 ]]; then
    die "expected exactly one running EC2 instance named ${EGRESS_GW_REMOTE_OUTPOST_INSTANCE_NAME} in ${cluster_vpc}, found ${#ids[@]}"
  fi

  printf '%s\n' "${ids[0]}"
}

configure_remote_outpost_allowed_ips() {
  [[ "${EGRESS_GW_REMOTE_OUTPOST_AUTOCONFIG}" == "true" ]] || { log "skip remote outpost autoconfig"; return 0; }

  if [[ -n "${EGRESS_GW_EGRESS_CIDRS}" ]]; then
    log "skip remote outpost autoconfig because EGRESS_GW_EGRESS_CIDRS is set"
    return 0
  fi

  local allowed_ips="${EGRESS_GW_SELECTED_NODE_IPS:-}"
  [[ -n "${allowed_ips}" ]] || die "no selected egress gateway node IPs found for remote outpost allowlist"

  local iid params
  iid="$(find_remote_outpost_instance_id)"
  log "configure remote outpost ${EGRESS_GW_REMOTE_OUTPOST_INSTANCE_NAME} (${iid}) allowed IPs: ${allowed_ips}"

  if ! wait_for_ssm_one "${iid}" "${EGRESS_GW_REMOTE_OUTPOST_SSM_TIMEOUT_SEC}"; then
    die "remote outpost instance ${iid} is not managed by SSM"
  fi

  params="${WORKDIR}/ssm-remote-outpost-${CLUSTER_ID}.json"
  cat > "${params}" <<EOF
{
  "commands": [
    "set -euo pipefail",
    "if ! command -v docker >/dev/null 2>&1; then echo 'docker not found' >&2; exit 1; fi",
    "sudo docker stop '${EGRESS_GW_REMOTE_OUTPOST_CONTAINER_NAME}' >/dev/null 2>&1 || true",
    "sudo docker rm '${EGRESS_GW_REMOTE_OUTPOST_CONTAINER_NAME}' >/dev/null 2>&1 || true",
    "sudo docker run -d --name '${EGRESS_GW_REMOTE_OUTPOST_CONTAINER_NAME}' --restart unless-stopped -p '${EGRESS_GW_REMOTE_OUTPOST_HOST_PORT}:${EGRESS_GW_REMOTE_OUTPOST_CONTAINER_PORT}' -e ALLOWED_IP='${allowed_ips}' '${EGRESS_GW_REMOTE_OUTPOST_IMAGE}'",
    "sudo docker ps --filter 'name=^/${EGRESS_GW_REMOTE_OUTPOST_CONTAINER_NAME}$' --format '{{.Names}} {{.Status}} {{.Ports}}'",
    "curl -sS --max-time 3 'http://127.0.0.1:${EGRESS_GW_REMOTE_OUTPOST_HOST_PORT}' || true"
  ]
}
EOF

  run_ssm_shell_instance "${iid}" "${params}" "${EGRESS_GW_REMOTE_OUTPOST_SSM_TIMEOUT_SEC}"
}

