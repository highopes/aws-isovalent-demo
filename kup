helm upgrade --install tetragon-policies isovalent/tetragon-policies \
  --version "${TPR_CHART_VER}" \
  -n kube-system \
  --kube-context "${CTX_ALIAS}" \
  -f "${TPR_OUT}"
kubectl --context "${CTX_ALIAS}" apply -f custom-java-b64-pipe-to-shell.yaml

log "install uf"
install_uf_all_nodes

log "restart unhealthy pods in kube-system (best-effort)"
bad_pods="$(
  kubectl --context "${CTX_ALIAS}" -n kube-system get pod --no-headers 2>/dev/null \
    | awk '{
        name=$1; ready=$2; status=$3;
        if (status=="Completed") next;
        split(ready,a,"/"); if (a[1]!=a[2]) {print name; next}
        if (status!="Running") {print name; next}
      }' \
    | sort -u \
    || true
)"

if [[ -n "${bad_pods}" ]]; then
  log "found unhealthy pods; deleting to trigger restart:"
  printf '%s\n' "${bad_pods}" | while IFS= read -r p; do
    [[ -n "${p}" ]] || continue
    log "delete pod: ${p}"
    kubectl --context "${CTX_ALIAS}" -n kube-system delete pod "${p}" \
      --ignore-not-found --grace-period=0 --force >/dev/null 2>&1 || true
  done
else
  log "no unhealthy pods found in kube-system"
fi

