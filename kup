render_template() {
  local in="$1"
  local out="$2"
  python3 - "$in" "$out" <<'PY'
import os, sys
from string import Template

inp, outp = sys.argv[1], sys.argv[2]
with open(inp, "r", encoding="utf-8") as f:
    s = f.read()
t = Template(s)
rendered = t.safe_substitute(os.environ)
with open(outp, "w", encoding="utf-8") as f:
    f.write(rendered)
PY
}

render_show() {
  local in="$1"
  local out="$2"
  log "render ${in} -> ${out}"
  render_template "${in}" "${out}"
  printf '\n----- BEGIN %s -----\n' "$(basename "${out}")"
  cat "${out}"
  printf '\n----- END %s -----\n\n' "$(basename "${out}")"
}

yaml_list_block() {
  local key="$1"
  local csv="$2"
  python3 - "$key" "$csv" <<'PY'
import sys

key, csv = sys.argv[1], sys.argv[2].strip()
items = [item.strip() for item in csv.split(",") if item.strip()]
if not items:
    raise SystemExit(0)
print(f"  {key}:")
for item in items:
    print(f'  - "{item}"')
PY
}

prepare_egress_gateway_template_vars() {
  [[ -n "${EGRESS_GW_DESTINATION_CIDRS}" ]] || die "EGRESS_GW_DESTINATION_CIDRS is empty"

  EGRESS_GW_DESTINATION_CIDRS_BLOCK="$(yaml_list_block destinationCIDRs "${EGRESS_GW_DESTINATION_CIDRS}")"
  [[ -n "${EGRESS_GW_DESTINATION_CIDRS_BLOCK}" ]] || die "failed to render destinationCIDRs"

  if [[ "${EGRESS_GW_HA_ENABLE}" == "true" ]]; then
    EGRESS_GW_POLICY_API_VERSION="isovalent.com/v1"
    EGRESS_GW_POLICY_KIND="IsovalentEgressGatewayPolicy"
    EGRESS_GW_AZ_AFFINITY_BLOCK="  azAffinity: ${EGRESS_GW_AZ_AFFINITY}"
    EGRESS_GW_GATEWAY_SELECTOR_BLOCK="$(cat <<EOF
  egressGroups:
  - nodeSelector:
      matchLabels:
        ${EGRESS_GW_NODE_LABEL_KEY}: "${EGRESS_GW_NODE_LABEL_VALUE}"
EOF
)"
    EGRESS_GW_EGRESS_CIDRS_BLOCK="$(yaml_list_block egressCIDRs "${EGRESS_GW_EGRESS_CIDRS}")"
  else
    EGRESS_GW_POLICY_API_VERSION="cilium.io/v2"
    EGRESS_GW_POLICY_KIND="CiliumEgressGatewayPolicy"
    EGRESS_GW_AZ_AFFINITY_BLOCK=""
    EGRESS_GW_GATEWAY_SELECTOR_BLOCK="$(cat <<EOF
  egressGateway:
    nodeSelector:
      matchLabels:
        ${EGRESS_GW_NODE_LABEL_KEY}: "${EGRESS_GW_NODE_LABEL_VALUE}"
EOF
)"
    EGRESS_GW_EGRESS_CIDRS_BLOCK=""
  fi

  export EGRESS_GW_POLICY_API_VERSION EGRESS_GW_POLICY_KIND EGRESS_GW_AZ_AFFINITY_BLOCK
  export EGRESS_GW_DESTINATION_CIDRS_BLOCK EGRESS_GW_GATEWAY_SELECTOR_BLOCK EGRESS_GW_EGRESS_CIDRS_BLOCK
}

inject_existing_vpc_cluster_config() {
  local cluster_yaml="$1"
  [[ "${USE_EXISTING_VPC}" == "true" ]] || return 0

  [[ -n "${EKS_VPC_ID}" ]] || die "EKS_VPC_ID is empty"
  log "use existing vpc for eks cluster: ${EKS_VPC_ID}"

  local data_json="${WORKDIR}/vpc-subnets-${CLUSTER_ID}.json"
  aws ec2 describe-subnets \
    --region "${REGION}" \
    --filters "Name=vpc-id,Values=${EKS_VPC_ID}" \
    --output json > "${data_json}"

  local rtb_json="${WORKDIR}/vpc-rtbs-${CLUSTER_ID}.json"
  aws ec2 describe-route-tables \
    --region "${REGION}" \
    --filters "Name=vpc-id,Values=${EKS_VPC_ID}" \
    --output json > "${rtb_json}"

  local vpc_block="${WORKDIR}/vpc-${CLUSTER_ID}.yaml"
  local subnet_ids="${WORKDIR}/vpc-subnet-ids-${CLUSTER_ID}.txt"

  python3 - "${data_json}" "${rtb_json}" "${vpc_block}" "${subnet_ids}" <<'PY'
import json, sys
from collections import defaultdict

subnets_json, rtbs_json, out_block, out_ids = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
subs = json.load(open(subnets_json, "r", encoding="utf-8")).get("Subnets", []) or []
rtbs = json.load(open(rtbs_json, "r", encoding="utf-8")).get("RouteTables", []) or []

main_rtb_id = None
rtb_by_id = {}
for rtb in rtbs:
    rid = rtb.get("RouteTableId")
    if rid:
        rtb_by_id[rid] = rtb
    for assoc in (rtb.get("Associations") or []):
        if assoc.get("Main"):
            main_rtb_id = rid

subnet_rtb = {}
for rtb in rtbs:
    rid = rtb.get("RouteTableId")
    for assoc in (rtb.get("Associations") or []):
        sid = assoc.get("SubnetId")
        if sid and rid:
            subnet_rtb[sid] = rid

def is_public_rtb(rtb):
    for r in (rtb.get("Routes") or []):
        if r.get("DestinationCidrBlock") == "0.0.0.0/0":
            gw = r.get("GatewayId") or ""
            if gw.startswith("igw-"):
                return True
    return False

pub = defaultdict(list)
priv = defaultdict(list)

for s in subs:
    sid = s.get("SubnetId")
    az = s.get("AvailabilityZone")
    if not sid or not az:
        continue

    rid = subnet_rtb.get(sid) or main_rtb_id
    rtb = rtb_by_id.get(rid) if rid else None
    if rtb and is_public_rtb(rtb):
        pub[az].append(sid)
    else:
        priv[az].append(sid)

priv_sel = {az: ids[0] for az, ids in sorted(priv.items()) if ids}
pub_sel = {az: ids[0] for az, ids in sorted(pub.items()) if ids}

lines = []
lines.append("vpc:")
lines.append("  id: __EKS_VPC_ID__")
lines.append("  subnets:")
lines.append("    private:")
for az, sid in priv_sel.items():
    lines.append(f"      {az}:")
    lines.append(f"        id: {sid}")
lines.append("    public:")
for az, sid in pub_sel.items():
    lines.append(f"      {az}:")
    lines.append(f"        id: {sid}")

with open(out_block, "w", encoding="utf-8") as f:
    f.write("\n".join(lines) + "\n")

with open(out_ids, "w", encoding="utf-8") as f:
    for az, sid in priv_sel.items():
        f.write(f"private {az} {sid}\n")
    for az, sid in pub_sel.items():
        f.write(f"public {az} {sid}\n")
PY

  sed -i.bak "s/__EKS_VPC_ID__/${EKS_VPC_ID}/g" "${vpc_block}" || true
  rm -f "${vpc_block}.bak" >/dev/null 2>&1 || true

  local priv_count pub_count total_count
  priv_count="$(awk '$1=="private"{c++} END{print c+0}' "${subnet_ids}")"
  pub_count="$(awk '$1=="public"{c++} END{print c+0}' "${subnet_ids}")"
  total_count=$((priv_count + pub_count))

  if (( total_count < 2 )); then
    die "not enough subnets in vpc ${EKS_VPC_ID} (need >=2 across AZ)"
  fi

  if [[ "${NG_PRIVATE_NETWORKING}" == "true" && "${priv_count}" -lt 2 ]]; then
    die "NG_PRIVATE_NETWORKING=true but found only ${priv_count} private subnets in vpc ${EKS_VPC_ID}"
  fi

  log "tag selected subnets for eks"
  while read -r kind az sid; do
    [[ -n "${sid}" ]] || continue
    aws ec2 create-tags \
      --region "${REGION}" \
      --resources "${sid}" \
      --tags "Key=kubernetes.io/cluster/${CLUSTER_NAME},Value=shared" \
      >/dev/null 2>&1 || true

    if [[ "${kind}" == "public" ]]; then
      aws ec2 create-tags \
        --region "${REGION}" \
        --resources "${sid}" \
        --tags "Key=kubernetes.io/role/elb,Value=1" \
        >/dev/null 2>&1 || true
    else
      aws ec2 create-tags \
        --region "${REGION}" \
        --resources "${sid}" \
        --tags "Key=kubernetes.io/role/internal-elb,Value=1" \
        >/dev/null 2>&1 || true
    fi
  done < "${subnet_ids}"

  log "inject vpc config block into ${cluster_yaml}"
  printf '\n# injected by kup: use existing vpc %s\n' "${EKS_VPC_ID}" >> "${cluster_yaml}"
  cat "${vpc_block}" >> "${cluster_yaml}"
}

wait_for_ds_ready() {
  local ns="$1"
  local name="$2"
  local timeout_sec="$3"
  local start now desired ready
  start="$(date +%s)"
  while true; do
    now="$(date +%s)"
    if (( now - start > timeout_sec )); then
      kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o wide || true
      die "timeout waiting for daemonset ready"
    fi
    desired="$(kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o jsonpath='{.status.desiredNumberScheduled}' 2>/dev/null || true)"
    ready="$(kubectl --context "${CTX_ALIAS}" -n "${ns}" get ds "${name}" -o jsonpath='{.status.numberReady}' 2>/dev/null || true)"
    if [[ -n "${desired}" && -n "${ready}" && "${desired}" == "${ready}" && "${desired}" != "0" ]]; then
      break
    fi
    sleep 5
  done
}

wait_for_crd_ready() {
  local name="$1"
  local timeout_sec="$2"
  kubectl --context "${CTX_ALIAS}" wait \
    --for=condition=Established \
    "crd/${name}" \
    "--timeout=${timeout_sec}s"
}

get_node_instance_ids() {
  kubectl --context "${CTX_ALIAS}" get nodes -o jsonpath='{range .items[*]}{.spec.providerID}{"\n"}{end}' \
    | awk -F/ 'NF>0{print $NF}' \
    | awk 'NF>0{print}'
}

cluster_exists() {
  aws eks describe-cluster \
    --name "${CLUSTER_NAME}" \
    --region "${REGION}" \
    --query "cluster.name" \
    --output text >/dev/null 2>&1
}

nodegroup_exists() {
  aws eks describe-nodegroup \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NG_NAME}" \
    --region "${REGION}" \
    --query "nodegroup.nodegroupName" \
    --output text >/dev/null 2>&1
}

ssm_is_managed() {
  local iid="$1"
  local got
  got="$(aws ssm describe-instance-information \
    --filters "Key=InstanceIds,Values=${iid}" \
    --query "InstanceInformationList[0].InstanceId" \
    --output text 2>/dev/null || true)"
  [[ "${got}" == "${iid}" ]]
}

wait_for_ssm_all() {
  local timeout_sec="$1"
  shift
  local ids=("$@")
  local deadline=$(( $(date +%s) + timeout_sec ))
  while :; do
    local ok=0
    local iid
    for iid in "${ids[@]}"; do
      if ssm_is_managed "${iid}"; then ok=$((ok+1)); fi
    done
    if [[ "${ok}" -eq "${#ids[@]}" ]]; then return 0; fi
    if [[ "$(date +%s)" -ge "${deadline}" ]]; then return 1; fi
    sleep 10
  done
}

wait_for_ssm_one() {
  local iid="$1"
  local timeout_sec="$2"
  local deadline=$(( $(date +%s) + timeout_sec ))
  while :; do
    if ssm_is_managed "${iid}"; then return 0; fi
    if [[ "$(date +%s)" -ge "${deadline}" ]]; then return 1; fi
    sleep 10
  done
}

ensure_node_role_ssm_policy_if_needed() {
  IDS=()
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "None" ]] || continue
    IDS+=("$line")
  done < <(get_node_instance_ids || true)
  [[ "${#IDS[@]}" -gt 0 ]] || die "no node instance ids found"

  if wait_for_ssm_all 60 "${IDS[@]}"; then
    log "ssm managed: ok"
    return 0
  fi

  log "ssm not ready for all nodes; try attach AmazonSSMManagedInstanceCore to node role"

  local role_arn role_name
  role_arn="$(aws eks describe-nodegroup \
    --cluster-name "${CLUSTER_NAME}" \
    --nodegroup-name "${NG_NAME}" \
    --region "${REGION}" \
    --query "nodegroup.nodeRole" \
    --output text)"

  [[ -n "${role_arn}" && "${role_arn}" != "None" ]] || die "failed to get node role arn"
  role_name="${role_arn##*/}"

  aws iam attach-role-policy \
    --role-name "${role_name}" \
    --policy-arn "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore" \
    >/dev/null 2>&1 || true

  if ! wait_for_ssm_all "${SSM_REGISTER_TIMEOUT_SEC}" "${IDS[@]}"; then
    die "ssm still not ready for all nodes"
  fi

  log "ssm managed: ok after attach"
}

run_ssm_shell_all_nodes() {
  local params_json="$1"
  IDS=()
  while IFS= read -r line; do
    [[ -n "$line" && "$line" != "None" ]] || continue
    IDS+=("$line")
  done < <(get_node_instance_ids)
  local cmd_id
  cmd_id="$(aws ssm send-command \
    --document-name "AWS-RunShellScript" \
    --instance-ids "${IDS[@]}" \
    --parameters "file://${params_json}" \
    --timeout-seconds "${SSM_COMMAND_TIMEOUT_SEC}" \
    --max-concurrency "${SSM_MAX_CONCURRENCY}" \
    --max-errors "${SSM_MAX_ERRORS}" \
    --query "Command.CommandId" \
    --output text)"
  log "ssm command id: ${cmd_id}"
  aws --no-cli-pager ssm list-command-invocations \
    --command-id "${cmd_id}" \
    --query "CommandInvocations[*].[InstanceId,Status,StatusDetails]" \
    --output table || true
}

run_ssm_shell_instance() {
  local iid="$1"
  local params_json="$2"
  local timeout_sec="$3"
  local cmd_id status

  cmd_id="$(aws ssm send-command \
    --document-name "AWS-RunShellScript" \
    --instance-ids "${iid}" \
    --parameters "file://${params_json}" \
    --timeout-seconds "${timeout_sec}" \
    --max-concurrency "1" \
    --max-errors "0" \
    --query "Command.CommandId" \
    --output text)"
  log "ssm command id for ${iid}: ${cmd_id}"

  aws --no-cli-pager ssm wait command-executed \
    --command-id "${cmd_id}" \
    --instance-id "${iid}" || true

  aws --no-cli-pager ssm list-command-invocations \
    --command-id "${cmd_id}" \
    --details \
    --query "CommandInvocations[*].CommandPlugins[*].[Name,Status,ResponseCode,Output]" \
    --output table || true

  status="$(aws ssm get-command-invocation \
    --command-id "${cmd_id}" \
    --instance-id "${iid}" \
    --query "Status" \
    --output text)"
  [[ "${status}" == "Success" ]] || die "ssm command ${cmd_id} failed on ${iid}: ${status}"
}

ensure_splunk_sg_ingress() {
  [[ "${SPLUNK_SG_AUTOCONFIG}" == "true" ]] || { log "skip splunk sg autoconfig"; return 0; }
  : "${SPLUNK_EC2_SG_ID:?}"

  local cluster_sg cluster_vpc splunk_vpc
  cluster_sg="$(aws eks describe-cluster \
    --name "${CLUSTER_NAME}" --region "${REGION}" \
    --query "cluster.resourcesVpcConfig.clusterSecurityGroupId" --output text)"
  cluster_vpc="$(aws eks describe-cluster \
    --name "${CLUSTER_NAME}" --region "${REGION}" \
    --query "cluster.resourcesVpcConfig.vpcId" --output text)"
  splunk_vpc="$(aws ec2 describe-security-groups \
    --group-ids "${SPLUNK_EC2_SG_ID}" \
