restart_unhealthy_pods_in_ns() {
  local ns="$1"
  log "restart unhealthy pods in ${ns} (best-effort)"

  local bad_pods
  bad_pods="$(
    kubectl --context "${CTX_ALIAS}" -n "${ns}" get pod --no-headers 2>/dev/null \
      | awk '{
          name=$1; ready=$2; status=$3;
          if (status=="Completed") next;
          split(ready,a,"/");
          if (a[1]!=a[2]) {print name; next}
          if (status!="Running") {print name; next}
        }' \
      | sort -u \
      || true
  )"

  if [[ -n "${bad_pods}" ]]; then
    log "found unhealthy pods; deleting to trigger restart:"
    printf '%s\n' "${bad_pods}" | while IFS= read -r p; do
      [[ -n "${p}" ]] || continue
      log "delete pod: ${p}"
      kubectl --context "${CTX_ALIAS}" -n "${ns}" delete pod "${p}" \
        --ignore-not-found --grace-period=0 --force >/dev/null 2>&1 || true
    done
  else
    log "no unhealthy pods found in ${ns}"
  fi
}

for ns in kube-system fsomonitor; do
